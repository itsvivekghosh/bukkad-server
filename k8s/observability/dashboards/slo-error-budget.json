{
  "title": "Bhukkad SLO / Error Budget",
  "description": "SLO burn-rate alerting and error-budget tracking dashboard. Shows remaining budget, burn-rate timeseries per SLO, and 30-day budget projection.",
  "tags": ["bhukkad", "slo", "error-budget", "burn-rate"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Error Budget Remaining (Latency SLO)",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_error_budget_remaining{slo=\"latency\"}",
          "legendFormat": "Latency SLO",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Exhausted", "color": "red"}, "1": {"text": "Full", "color": "green"}}}
          ]
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      }
    },
    {
      "id": 2,
      "title": "Error Budget Remaining (Availability SLO)",
      "type": "gauge",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_error_budget_remaining{slo=\"availability\"}",
          "legendFormat": "Availability SLO",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      }
    },
    {
      "id": 3,
      "title": "Burn Rate - Latency SLO",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_burn_rate{slo=\"latency\"}",
          "legendFormat": "{{service}} - {{method}} - {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 3},
              {"color": "red", "value": 6}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 4,
      "title": "Burn Rate - Availability SLO",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_burn_rate{slo=\"availability\"}",
          "legendFormat": "{{service}} - {{method}} - {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 3},
              {"color": "red", "value": 6}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 5,
      "title": "30-Day Budget Projection - Latency SLO",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_error_budget_remaining{slo=\"latency\"} - (slo_burn_rate{slo=\"latency\"} * (30 * 24 * 60 / 60))",
          "legendFormat": "{{service}} - {{method}} - {{uri}} (projected)",
          "refId": "A"
        },
        {
          "expr": "slo_error_budget_remaining{slo=\"latency\"}",
          "legendFormat": "{{service}} - {{method}} - {{uri}} (current)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 6,
      "title": "30-Day Budget Projection - Availability SLO",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "slo_error_budget_remaining{slo=\"availability\"} - (slo_burn_rate{slo=\"availability\"} * (30 * 24 * 60 / 60))",
          "legendFormat": "{{service}} - {{method}} - {{uri}} (projected)",
          "refId": "A"
        },
        {
          "expr": "slo_error_budget_remaining{slo=\"availability\"}",
          "legendFormat": "{{service}} - {{method}} - {{uri}} (current)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "title": "Latency Error Ratio (500ms threshold) by Endpoint",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "1 - sum(rate(bhukkad_http_requests_seconds_bucket{le=\"0.5\"}[5m])) by (service, method, uri) / sum(rate(bhukkad_http_requests_seconds_count[5m])) by (service, method, uri)",
          "legendFormat": "{{service}} {{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.005},
              {"color": "red", "value": 0.01}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "title": "Availability Error Ratio (5xx) by Endpoint",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(bhukkad_http_errors_total[5m])) by (service, method, uri) / sum(rate(bhukkad_http_requests_seconds_count[5m])) by (service, method, uri)",
          "legendFormat": "{{service}} {{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.001},
              {"color": "red", "value": 0.005}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus Data Source",
        "pluginId": "prometheus",
        "default": "prometheus",
        "current": {"text": "prometheus", "value": "prometheus"},
        "options": []
      }
    ]
  }
}