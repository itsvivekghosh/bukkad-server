# Non-secret deploy configuration (mirror in GitHub → Settings → Variables).
# Secrets (passwords, keys) are NEVER stored here — only in GitHub Secrets.

# EC2 public DNS (update when instance IP changes; prefer Elastic IPs)
STAGING_EC2_HOST=ec2-65-1-112-216.ap-south-1.compute.amazonaws.com
PROD_EC2_HOST=ec2-13-201-21-45.ap-south-1.compute.amazonaws.com

# Application
APP_PORT=8080
HEALTH_PATH=/api/v1/health/ping
CONTAINER_NAME=bhukkad-app

# Container registry
GHCR_IMAGE=ghcr.io/itsvivekghosh/bukkad-server
GHCR_USERNAME=itsvivekghosh

# Feature toggles (defaults; override via GitHub Variables)
STAGING_REDIS_LOCAL=true
PROD_REDIS_LOCAL=true
FLYWAY_REPAIR_ON_DEPLOY=false
