    {
      "title": "Funnel Error Rate (% of requests)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(order_funnel_errors_total[5m])) by (stage) / clamp_min(sum(rate(order.funnel.total{stage=~\"order_create|payment_authorize|delivery_assign\"}[5m])), 1e-6)",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.03
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
