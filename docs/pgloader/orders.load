-- pgloader command file: orders service database
-- Usage:
--   pgloader -v -L pgloader.log \
--     --set "MYSQL_USER=..." --set "MYSQL_PASSWORD=..." --set "MYSQL_HOST=mysql" \
--     --set "PG_USER=bhukkad" --set "PG_PASSWORD=..." --set "PG_HOST=pg" \
--     docs/pgloader/orders.load
--
-- Loads ONLY the orders-domain tables (ownership matrix §5). Other services
-- must never load these tables into their own databases.

LOAD DATABASE
     FROM mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/bhukkad
     INTO postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:5432/bhukkad_orders

 WITH include drop, create tables, create indexes, reset sequences,
      disable triggers,
      batch rows = 10000, batch concurrency = 1,
      prefetch rows = 5000

 SET PostgreSQL PARAMETERS
     maintenance_work_mem = '1GB',
     work_mem = '128MB',
     synchronous_commit = 'off'

 CAST type datetime to timestamp drop default drop not null,
      type timestamp drop default drop not null,
      type tinyint to boolean,
      type bit to boolean,
      type decimal to numeric,
      type float to double precision,
      type year to integer

 INCLUDING ONLY TABLE NAMES MATCHING ~/^orders/, ~/^order_/, ~/^cart/, ~/^subscription/, ~/^group_order/, ~/^gift/

 AFTER LOAD DO
     $$ ANALYZE; $$;
