-- pgloader command file: restaurant service database
-- Source is the monolith PostgreSQL DB (post MySQL->PostgreSQL migration).
-- Owned tables: restaurants + menu domain (ownership matrix §5).
-- NOTE: restaurant_owners is an IDENTITY table (holds password_hash/totp) and is
-- intentionally NOT matched here — it is owned by identity.load. pgloader
-- matches /^restaurant/ against restaurant_owners, so this file enumerates the
-- restaurant-owned tables explicitly to avoid a data-ownership collision.
--
-- Usage:
--   pgloader -v -L pgloader.log \
--     --set "MONOLITH_PG_USER=bhukkad" --set "MONOLITH_PG_PASSWORD=..." \
--     --set "MONOLITH_PG_HOST=localhost" \
--     --set "PG_USER=bhukkad" --set "PG_PASSWORD=..." --set "PG_HOST=pg" \
--     docs/pgloader/restaurants.load

LOAD DATABASE
     FROM postgresql://${MONOLITH_PG_USER}:${MONOLITH_PG_PASSWORD}@${MONOLITH_PG_HOST}:5432/bhukkad
     INTO postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:5432/bhukkad_restaurants

 WITH include drop, create tables, create indexes, reset sequences,
      data only,
      batch rows = 10000, batch concurrency = 1,
      prefetch rows = 5000

 SET PostgreSQL PARAMETERS
     maintenance_work_mem = '1GB',
     work_mem = '128MB',
     synchronous_commit = 'off'

 INCLUDING ONLY TABLE NAMES MATCHING
     ~/^restaurants$/,
     ~/^restaurant_cuisines$/,
     ~/^restaurant_features$/,
     ~/^restaurant_food_types$/,
     ~/^restaurant_gallery$/,
     ~/^restaurant_order_stats$/,
     ~/^restaurant_ratings_summary$/,
     ~/^restaurant_settlements$/,
     ~/^menu_/, ~/^cuisine/, ~/^inventory/, ~/^trending/, ~/^promo_/

 AFTER LOADING DO
     $$ ANALYZE; $$;
