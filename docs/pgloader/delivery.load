-- pgloader command file: delivery service database
-- Owned tables: delivery agents/zones/riders/shifts (ownership matrix §5).

LOAD DATABASE
     FROM mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/bhukkad
     INTO postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:5432/bhukkad_delivery

 WITH include drop, create tables, create indexes, reset sequences,
      disable triggers,
      batch rows = 10000, batch concurrency = 1,
      prefetch rows = 5000

 SET PostgreSQL PARAMETERS
     maintenance_work_mem = '1GB', work_mem = '128MB', synchronous_commit = 'off'

 CAST type datetime to timestamp drop default drop not null,
      type timestamp drop default drop not null,
      type tinyint to boolean,
      type bit to boolean,
      type decimal to numeric,
      type float to double precision,
      type year to integer

 INCLUDING ONLY TABLE NAMES MATCHING ~/^delivery_/, ~/^rider_/, ~/^agent_/, ~/^zone_/

 AFTER LOAD DO
     $$ ANALYZE; $$;
