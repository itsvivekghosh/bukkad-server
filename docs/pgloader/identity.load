-- pgloader command file: identity service database
-- Source is the monolith PostgreSQL DB (post MySQL->PostgreSQL migration).
-- Owned tables: users/customers/owners/agents/admins + auth (ownership matrix §5).
-- NOTE: restaurant_owners matches here (it holds password_hash/totp => auth),
-- and restaurants.load explicitly excludes it to avoid a double-load collision.
--
-- Usage:
--   pgloader -v -L pgloader.log \
--     --set "MONOLITH_PG_USER=bhukkad" --set "MONOLITH_PG_PASSWORD=..." \
--     --set "MONOLITH_PG_HOST=localhost" \
--     --set "PG_USER=bhukkad" --set "PG_PASSWORD=..." --set "PG_HOST=pg" \
--     docs/pgloader/identity.load

LOAD DATABASE
     FROM postgresql://${MONOLITH_PG_USER}:${MONOLITH_PG_PASSWORD}@${MONOLITH_PG_HOST}:5432/bhukkad
     INTO postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:5432/bhukkad_identity

 WITH include drop, create tables, create indexes, reset sequences,
      data only,
      batch rows = 10000, batch concurrency = 1,
      prefetch rows = 5000

 SET PostgreSQL PARAMETERS
     maintenance_work_mem = '1GB',
     work_mem = '128MB',
     synchronous_commit = 'off'

 INCLUDING ONLY TABLE NAMES MATCHING
     ~/^users$/, ~/^customers$/, ~/^restaurant_owners$/, ~/^delivery_agents$/,
     ~/^admins$/, ~/^addresses$/, ~/^device_tokens$/, ~/^consent/, ~/^user_referral/

 AFTER LOADING DO
     $$ ANALYZE; $$;
