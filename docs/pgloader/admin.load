-- pgloader command file: admin/analytics service database
-- Source is the monolith PostgreSQL DB (post MySQL->PostgreSQL migration).
-- Owned tables: admin operations + analytics + compliance (ownership matrix §5).
--
-- Usage:
--   pgloader -v -L pgloader.log \
--     --set "MONOLITH_PG_USER=bhukkad" --set "MONOLITH_PG_PASSWORD=..." \
--     --set "MONOLITH_PG_HOST=localhost" \
--     --set "PG_USER=bhukkad" --set "PG_PASSWORD=..." --set "PG_HOST=pg" \
--     docs/pgloader/admin.load

LOAD DATABASE
     FROM postgresql://${MONOLITH_PG_USER}:${MONOLITH_PG_PASSWORD}@${MONOLITH_PG_HOST}:5432/bhukkad
     INTO postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:5432/bhukkad_admin

 WITH include drop, create tables, create indexes, reset sequences,
      data only,
      batch rows = 10000, batch concurrency = 1,
      prefetch rows = 5000

 SET PostgreSQL PARAMETERS
     maintenance_work_mem = '1GB',
     work_mem = '128MB',
     synchronous_commit = 'off'

 INCLUDING ONLY TABLE NAMES MATCHING
     ~/^audit_/, ~/^fraud_/, ~/^churn/, ~/^experiment/, ~/^api_keys$/,
     ~/^data_export/, ~/^support_tickets$/, ~/^settlement/

 AFTER LOADING DO
     $$ ANALYZE; $$;
