[mysqld]
# Character Set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Performance — sized for high-traffic: buffer pool ~50% of available RAM
# per pod; raise with MYSQL_MEM_LIMIT. 512M handles ~500 connections safely.
innodb_buffer_pool_size=512M
innodb_redo_log_capacity=256M
innodb_flush_log_at_trx_commit=2

# Connections — production formula: pods × pool_size ≤ 0.8 × max_connections
# Example: 10 pods × 20 pool = 200 (prod default) << 500 with headroom for admin.
max_connections=500
max_connect_errors=10000
wait_timeout=600
interactive_timeout=600

# Logging (query cache removed in MySQL 8.0)
slow_query_log=1
slow_query_log_file=/var/lib/mysql/slow.log
long_query_time=2

# Temp Tables
tmp_table_size=64M
max_heap_table_size=64M

# Sort and Join
sort_buffer_size=4M
join_buffer_size=4M
read_buffer_size=2M
read_rnd_buffer_size=4M

[mysql]
default-character-set=utf8mb4

[client]
default-character-set=utf8mb4