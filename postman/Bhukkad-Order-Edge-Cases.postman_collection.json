            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('Response has id', () => { const json = pm.response.json(); pm.expect(json.id).to.be.a('number'); });"
                ]
