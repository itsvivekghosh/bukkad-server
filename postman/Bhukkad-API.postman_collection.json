{
  "info": {
    "name": "Bhukkad Food Delivery API",
    "description": "Reconstructed Postman collection (v1) for the Bhukkad Food Delivery System.\n\nSource of truth: docs/api/*.md, docs/bhukkad-api-consolidated-reference.md.\nGenerated during the QA audit after the previous collection was removed in a cleanup pass.\nEvery request asserts status code, the ApiResponse envelope (success/traceId), and key schema fields via Newman 'tests'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "restaurantId",
      "value": "1"
    },
    {
      "key": "addressId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope has status=pong', () => pm.expect(pm.response.json().status).to.eql('pong'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detailed",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/detailed"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has subsystem probes', () => { const b = pm.response.json(); pm.expect(b).to.have.property('database'); pm.expect(b).to.have.property('redis'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"QA User\",\n  \"email\": \"qa.user@example.com\",\n  \"password\": \"Test@123456\",\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope success', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('returns accessToken', () => { const t = pm.response.json().data.accessToken; pm.expect(t).to.be.a('string'); pm.collectionVariables.set('accessToken', t); });"
                ]
              }
            }
          ],
          "x-expected": [
            400
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa.user@example.com\",\n  \"password\": \"Test@123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('captures tokens', () => { const d = pm.response.json().data; pm.collectionVariables.set('accessToken', d.accessToken); pm.collectionVariables.set('refreshToken', d.refreshToken); });"
                ]
              }
            }
          ],
          "x-expected": [
            401
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "x-expected": [
            200
          ]
        },
        {
          "name": "Forgot Password (validation, no email sent locally)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password?email=qa.user@example.com"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 (best-effort)', () => pm.expect([200,400,429]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Customer & Cart",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customers/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/cart/add",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"menuItemId\": 1,\n  \"quantity\": 2,\n  \"specialInstructions\": \"Less spicy\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cart",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order (sync)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/customer/create",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"deliveryAddressId\": {{addressId}},\n  \"paymentMethod\": \"UPI\",\n  \"useWallet\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope', () => { const b = pm.response.json(); pm.expect(b.success).to.be.true; pm.expect(b).to.have.property('traceId'); if (b.data && b.data.id) pm.collectionVariables.set('orderId', b.data.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order (async)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/customer/create?async=true",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"deliveryAddressId\": {{addressId}},\n  \"paymentMethod\": \"COD\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/customer/my-orders",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Track Order",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/customer/track/{{orderId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Wallet Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customers/wallet/balance",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Razorpay Webhook (signature check)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/webhooks/razorpay",
            "header": [
              {
                "key": "X-Razorpay-Signature",
                "value": "invalid"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"event\":\"payment.captured\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rejects invalid signature (400/401/403)', () => pm.expect([400,401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "x-expected": [
            400
          ]
        }
      ]
    },
    {
