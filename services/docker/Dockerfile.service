# syntax=docker/dockerfile:1.7
# =============================================================================
# CANONICAL service image recipe (R-02 consolidation — audit G-13).
#
# This is the ONLY image build path for all Bhukkad microservices. The former
# 12 per-service Dockerfiles (services/*/Dockerfile) and the two rival
# templates (services/docker/Dockerfile.template, Dockerfile.prebuilt) were
# consolidated into this file: CI and the dev compose both build through here.
#
# Build (from the REACTOR ROOT services/ so the build context contains
# pom.xml, platform-lib/ and the module sources):
#
#   docker buildx build \
#     -f services/docker/Dockerfile.service \
#     --build-arg MODULE=commerce \
#     services/
#
# CI note (integrator): .github/workflows/services.yml builds each matrix
# entry with `-f services/${svc}/Dockerfile`; those files are removed here and
# the workflow must be rewired to the single line above (see final report).
# =============================================================================

# --- build stage -------------------------------------------------------------
# MODULE is passed via --build-arg and selects the service reactor module
# (identity, commerce, catalog, engagement, admin, gateway). Declared here AND
# re-declared inside each stage: an ARG declared before the first FROM is not
# automatically visible after FROM.
#
# NOTE ON MERGED MODULES: commerce / catalog / engagement / admin are the
# post-merge consolidations. `mvn -am` pulls in their intra-merge dependencies
# (engagement depends on commerce + catalog), and the source COPY below lists
# every reactor module so `-am` can always resolve them.
ARG MODULE
FROM --platform=$BUILDPLATFORM maven:3.9.9-eclipse-temurin-21 AS builder
ARG MODULE
WORKDIR /build

# Cache-optimized dependency resolution (preserved from the per-service
# Dockerfiles): copy the pom skeleton first, resolve the full dependency graph
# into a locked cache mount, THEN copy sources — unchanged sources no longer
# invalidate the expensive dependency layer.
COPY pom.xml .
COPY pom.xml ./services/pom.xml
# lombok.config at the build-context root (repo commit 2b42050: without it the
# copyableAnnotations += @Lazy setting is lost). Glob form tolerates contexts
# where the file is absent, unlike `COPY x . 2>/dev/null || true` which is NOT
# shell — a missing file hard-fails the build.
COPY lombok.config* ./
# EVERY reactor module's pom must exist before Maven parses the parent
# (<modules> is validated eagerly) — the old per-service Dockerfiles copied
# only the target module's pom and hard-failed on reactor parse. Adding a
# service = add its pom line here AND to services/pom.xml.
COPY platform-lib/pom.xml ./platform-lib/pom.xml
COPY gateway/pom.xml ./gateway/pom.xml
COPY identity/pom.xml ./identity/pom.xml
COPY commerce/pom.xml ./commerce/pom.xml
COPY catalog/pom.xml ./catalog/pom.xml
COPY engagement/pom.xml ./engagement/pom.xml
COPY admin/pom.xml ./admin/pom.xml
COPY ${MODULE}/pom.xml ./${MODULE}/pom.xml
# No dependency:go-offline pre-pass: it is notoriously flaky ("Failed to read
# artifact descriptor" on transitive poms) and the locked cache mount below
# gives the same reuse — the first `package` run populates /root/.m2, and every
# subsequent build (any module, any source change) resolves from cache.
# The pom-first COPY order above still keeps the classic layer cache warm for
# builders without cache-mount support.
# Source copy: platform-lib + the target module + every other service module
# that can appear in the reactor when Maven resolves -am dependencies.
COPY platform-lib ./platform-lib
COPY admin ./admin
COPY catalog ./catalog
COPY commerce ./commerce
COPY engagement ./engagement
COPY gateway ./gateway
COPY identity ./identity
COPY ${MODULE} ./${MODULE}
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -q clean package -DskipTests -Dmaven.test.skip=true -pl ${MODULE} -am

# --- runtime stage -----------------------------------------------------------
FROM eclipse-temurin:21-jre-jammy AS runtime
ARG MODULE
ENV TZ=Asia/Kolkata \
    LANG=C.UTF-8 \
    SPRING_PROFILES_ACTIVE=prod \
    SERVER_PORT=8080 \
    # Canonical JVM container contract (audit P-09 / perf guide §4.1 / roadmap
    # P-09 step-2 uniform set):
    #   MaxRAMPercentage=75      heap = 75% of the container memory limit
    #                            (requests==limits ⇒ Guaranteed QoS, no
    #                            node-sizing roulette)
    #   ExitOnOutOfMemoryError   OOM ⇒ process exits 137, kubelet replaces
    #                            the pod instead of a half-dead JVM serving
    #                            garbage (G-16 drain still runs on SIGTERM)
    #   G1 + MaxGCPauseMillis=200 bounded pause times under 1-2Gi heaps
    #   UseStringDeduplication   G1-side dedup for duplicated payloads
    #   gc.log rotation          5×20M in the log dir the FluentBit tail ships
    #                            to Loki (P-09 step-2)
    # Per-service overrides (heap ceiling on the dev VM, extra flags) are
    # injected via the JAVA_OPTS env in docker-compose.dev.yml / k8s env —
    # this ENV is the BASELINE, not the ceiling.
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError -XX:+UseStringDeduplication -Xlog:gc*:file=/tmp/logs/bhukkad/gc.log:time,uptime:filecount=5,filesize=20M -Djava.security.egd=file:/dev/./urandom"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo "$TZ" > /etc/timezone \
    && groupadd -r -g 1001 bhukkad \
    && useradd -r -u 1001 -g bhukkad -d /app -s /usr/sbin/nologin bhukkad \
    && mkdir -p /tmp/logs/bhukkad /app \
    && chown -R bhukkad:bhukkad /tmp/logs/bhukkad /app

WORKDIR /app
# exec form via sh -c so $JAVA_OPTS expands; `exec` hands PID 1 to the JVM so
# SIGTERM (G-16 graceful drain, terminationGracePeriodSeconds=90) reaches it.
COPY --from=builder --chown=bhukkad:bhukkad /build/${MODULE}/target/*.jar /app/
RUN if ls /app/${MODULE}-*-exec.jar >/dev/null 2>&1; then mv /app/${MODULE}-*-exec.jar /app/app.jar; else mv /app/${MODULE}-[0-9]*.jar /app/app.jar; fi
USER bhukkad
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=30s --start-period=1800s --retries=40 \
  CMD curl -fsS "http://localhost:${SERVER_PORT}/actuator/health/readiness" >/dev/null || exit 1
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
