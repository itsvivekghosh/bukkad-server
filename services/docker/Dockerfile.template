# Multi-stage build for bhukkad services. Each service module has an identical
# Dockerfile (only the final jar name differs); this is the template.
# Build from the reactor root: docker build -f <service>/Dockerfile .

# --- build stage ---
FROM eclipse-temurin:17-jdk AS build
WORKDIR /workspace
COPY . .
# Build only this module + its reactor dependencies into /workspace/multi-module
RUN ./mvnw -q -f services/pom.xml -pl <MODULE> -am package -DskipTests

# --- runtime stage ---
FROM eclipse-temurin:17-jre
RUN useradd --system --uid 10001 bhukkad
WORKDIR /app
COPY --from=build /workspace/services/<MODULE>/target/*.jar app.jar
USER bhukkad
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
