<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.12</version>
		<relativePath/>
	</parent>

	<groupId>com.bhukkad</groupId>
	<artifactId>bhukkad-microservices</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Bhukkad Microservices Reactor</name>
	<description>Services reactor for the PostgreSQL microservices migration
		(docs/architecture-microservices-postgresql.md §4). The monolith root pom
		remains the standalone "before" build until the teardown phase.</description>

<modules>
  		<module>platform-lib</module>
  		<!-- Edge gateway (P0). Built last-relevant; routes by path to per-service
  		     k8s DNS names so strangler flips are route-only edits. -->
  		<module>gateway</module>
  		<module>identity</module>
  		<!-- Core commerce domain: orders + payments + delivery -->
  		<module>commerce</module>
  		<!-- Read-heavy catalog domain: restaurants + search + personalization -->
  		<module>catalog</module>
  		<!-- User-facing engagement features: social + growth + referral + survey + notification + realtime -->
  		<module>engagement</module>
  		<!-- Internal tools: admin analytics + support tickets -->
  		<module>admin</module>
  	</modules>

	<properties>
		<java.version>21</java.version>
		<lombok.version>1.18.38</lombok.version>
 		<mapstruct.version>1.5.5.Final</mapstruct.version>
 		<testcontainers.version>1.20.4</testcontainers.version>
 		<archunit.version>1.3.0</archunit.version>
 		<byte-buddy.version>1.17.6</byte-buddy.version>
 		<pact.version>4.7.5</pact.version>
  		<jwt.version>0.12.7</jwt.version>
  		<spring-kafka.version>3.3.6</spring-kafka.version>
  		<!-- Spring Cloud (Gateway, LoadBalancer). Managed by the BOM import
 		     below; 2023.0.x is the line compatible with Spring Boot 3.2.x. -->
 		<spring-cloud.version>2023.0.5</spring-cloud.version>
 		<argLine></argLine>
 	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Spring Cloud BOM (Gateway 4.1.x, LoadBalancer) aligned to
			     Spring Boot 3.2.x. Imported so gateway transitive versions
			     resolve correctly across the reactor. -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Shared platform library consumed by every service module. -->
 		<dependency>
 			<groupId>com.bhukkad</groupId>
 			<artifactId>platform-lib</artifactId>
 			<version>${project.version}</version>
 		</dependency>

			<dependency>
				<groupId>net.bytebuddy</groupId>
				<artifactId>byte-buddy</artifactId>
				<version>${byte-buddy.version}</version>
			</dependency>
			<dependency>
				<groupId>net.bytebuddy</groupId>
				<artifactId>byte-buddy-agent</artifactId>
				<version>${byte-buddy.version}</version>
			</dependency>
			<!-- Lettuce connection pooling. spring-boot-starter-data-redis marks
			     commons-pool2 optional, so with
			     spring.data.redis.lettuce.pool.enabled=true the pool was
			     silently never built and the configured budgets
			     (max-active / max-idle / max-wait) had no effect. Modules that
			     turn pooling on must declare it; admin needs it or the Redis
			     health contributor fails with
			     NoClassDefFoundError: GenericObjectPoolConfig. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-pool2</artifactId>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- JaCoCo coverage gate for every service module (approved plan
			     Phases 29–30: 100% target with meaningful tests; enforced
			     minimums aligned with the monolith's gate while services are
			     young). Thresholds are raised as coverage grows — never by
			     excluding business logic. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<!-- Data containers, generated code and bootstrap are
						     excluded; business logic stays in scope. -->
						<exclude>com/bhukkad/*/dto/**</exclude>
						<exclude>com/bhukkad/*/api/dto/**</exclude>
						<exclude>com/bhukkad/*/entity/**</exclude>
						<exclude>com/bhukkad/*/domain/entity/**</exclude>
						<exclude>com/bhukkad/*/*Application.class</exclude>
						<exclude>com/bhukkad/common/**/*Config.class</exclude>
					</excludes>
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
							<!-- Regression-protection floor for the young service
							     modules, aligned to the Part IV coverage ramp
							     (docs/TECHNICAL-AUDIT-FEATURE-ROADMAP.md): this is
							     the highest UNIFORM floor the reactor passes today
							     (per-module floors are not expressible in the
							     parent pom). Measured full-reactor run 2026-09-11
							     (./mvnw -f services/pom.xml test):
							       LINE   binding module survey    34.9% -> 0.34
							       BRANCH binding module restaurant 23.7% -> 0.23
							       METHOD binding module survey    36.1% -> 0.35
							     Ramp-step 2 target is >=45% overall (>=60% for
							     gateway/delivery/admin-analytics/identity). KNOWN
							     GAPS still below the ramp target (their test
							     backlog lives with the service-extraction
							     batches; do NOT pad with filler tests):
							       survey 34.9%, restaurant 43.2%, order 43.2%,
							       referral 47.0% (meets 45% only marginally).
							     Raise the floor as each module's measured
							     coverage grows — never by excluding business
							     logic. -->
							<limit>
								<counter>LINE</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.34</minimum>
							</limit>
							<limit>
								<counter>BRANCH</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.23</minimum>
							</limit>
							<limit>
								<counter>METHOD</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.35</minimum>
							</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Inherited by every module: pre-load Byte Buddy as a -javaagent so
			     Mockito's inline mock-maker never performs dynamic self-attachment
			     (same rationale as the monolith pom: JDK 17 attach races poison the
			     surefire fork). Declared here (not pluginManagement) so the copy
			     execution actually runs in each module. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-byte-buddy-agent</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<artifactItems>
								<artifactItem>
									<groupId>net.bytebuddy</groupId>
									<artifactId>byte-buddy-agent</artifactId>
									<version>${byte-buddy.version}</version>
									<type>jar</type>
									<destFileName>byte-buddy-agent.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- JaCoCo coverage gate for every service module (approved plan
				     Phases 29–30: 100% target with meaningful tests; enforced
				     minimums aligned with the monolith's gate while services are
				     young). Thresholds are raised as coverage grows — never by
				     excluding business logic. -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>0.8.13</version>
					<configuration>
						<excludes>
							<!-- Data containers, generated code and bootstrap are
							     excluded; business logic stays in scope. -->
							<exclude>com/bhukkad/*/dto/**</exclude>
							<exclude>com/bhukkad/*/api/dto/**</exclude>
							<exclude>com/bhukkad/*/entity/**</exclude>
							<exclude>com/bhukkad/*/domain/entity/**</exclude>
							<exclude>com/bhukkad/*/*Application.class</exclude>
							<exclude>com/bhukkad/common/**/config/*Properties*</exclude>
							<exclude>com/bhukkad/common/**/*Config.class</exclude>
						</excludes>
						<rules>
							<rule>
								<element>BUNDLE</element>
								<limits>
									<!-- P2 repair: keep the managed block in lock-step
									     with the EFFECTIVE build/plugins rule above
									     (the previous 0.70/0.50/0.60 values here were
									     dead config that never applied — a module
									     plugin declaration with its own configuration
									     overrides pluginManagement). This block only
									     applies to modules that opt out of the parent
									     build section; do not diverge from the
									     effective values. -->
									<limit>
										<counter>LINE</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.34</minimum>
									</limit>
									<limit>
										<counter>BRANCH</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.23</minimum>
									</limit>
									<limit>
										<counter>METHOD</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.35</minimum>
									</limit>
								</limits>
							</rule>
						</rules>
					</configuration>
					<executions>
						<execution>
							<id>jacoco-prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>test</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Djdk.attach.allowAttachSelf=false</argLine>
						<forkCount>1</forkCount>
						<reuseForks>true</reuseForks>
						<runOrder>alphabetical</runOrder>
						<systemPropertyVariables>
							<api.version>1.44</api.version>
						</systemPropertyVariables>
					</configuration>
				</plugin>
<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>
					<useIncrementalCompilation>false</useIncrementalCompilation>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
