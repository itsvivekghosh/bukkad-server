<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>

	<groupId>com.bhukkad</groupId>
	<artifactId>bhukkad-microservices</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Bhukkad Microservices Reactor</name>
	<description>Services reactor for the PostgreSQL microservices migration
		(docs/architecture-microservices-postgresql.md §4). The monolith root pom
		remains the standalone "before" build until the teardown phase.</description>

<modules>
  		<module>platform-lib</module>
  		<!-- Edge gateway (P0). Built last-relevant; routes by path to per-service
  		     k8s DNS names so strangler flips are route-only edits. -->
  		<module>gateway</module>
  		<module>identity</module>
  		<!-- Core commerce domain: orders + payments + delivery -->
  		<module>commerce</module>
  		<!-- Read-heavy catalog domain: restaurants + search + personalization -->
  		<module>catalog</module>
  		<!-- User-facing engagement features: social + growth + referral + survey + notification + realtime -->
  		<module>engagement</module>
  		<!-- Internal tools: admin analytics + support tickets -->
  		<module>admin</module>
  	</modules>

	<properties>
		<java.version>17</java.version>
		<lombok.version>1.18.38</lombok.version>
 		<mapstruct.version>1.5.5.Final</mapstruct.version>
 		<testcontainers.version>1.20.4</testcontainers.version>
 		<archunit.version>1.3.0</archunit.version>
 		<byte-buddy.version>1.17.6</byte-buddy.version>
 		<pact.version>4.7.5</pact.version>
 		<jwt.version>0.12.7</jwt.version>
 		<spring-kafka.version>3.3.16</spring-kafka.version>
 		<!-- Patch-level pins for the CI Trivy gate. Boot 3.5.16 manages these
 		     lines, but its release predates the security fixes Trivy enforces;
 		     these override with the fixed patch releases of the SAME line
 		     (no major-version drift). netty is pinned via the netty-bom import
 		     in dependencyManagement (a property override leaves foreign pins in
 		     place); see the jackson/httpcore5/etc. entries there for artifacts
 		     Boot imports via BOMs where a property override would not reach. -->
 		<tomcat.version>10.1.61</tomcat.version>
 		<!-- Spring Cloud (Gateway, LoadBalancer). Managed by the BOM import
 		     below; 2025.0.x is the release train aligned with Spring Boot
 		     3.5.x (2025.1.x moved to Boot 4.0). -->
 		<spring-cloud.version>2025.0.3</spring-cloud.version>
 		<argLine></argLine>
 	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- netty-bom imported FIRST so a single version manages every netty
			     artifact (core + native/classifier). Overriding the Boot
			     netty.version property alone leaves foreign pins (e.g.
			     netty-transport-classes-epoll 4.1.108 via kafka/testcontainers,
			     netty-resolver-dns-native-macos 4.1.135) in place — the mix
			     breaks reactor-netty (NoClassDefFoundError
			     DnsNameResolverChannelStrategy). The BOM import wins over all
			     transitive pins. Version is the fixed release for the CVEs
			     Trivy flags in the 4.1 line. -->
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-bom</artifactId>
				<version>4.1.137.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- The two classifier artifacts netty-bom does NOT manage. Without
			     them the classpath mixes versions (reactor-netty pins
			     netty-transport-classes-epoll to its own minimum), which is what
			     broke reactor-netty's DNS resolver initialization. -->
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-transport-classes-epoll</artifactId>
				<version>4.1.137.Final</version>
			</dependency>
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-resolver-dns-classes-macos</artifactId>
				<version>4.1.137.Final</version>
			</dependency>
			<!-- Spring Cloud BOM (Gateway, LoadBalancer) aligned to
			     Spring Boot 3.5.x (release train 2025.0.x). Imported so gateway
			     transitive versions resolve correctly across the reactor. -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- CVE remediation: these are NOT Spring-Boot-managed (they arrive
			     transitively at older versions), so the CI Trivy gate keeps
			     flagging them. Pinning the FIXED versions here overrides every
			     transitive resolution: commons-io 2.14.0 (CVE-2024-47554),
			     commons-fileupload 1.6.0 (CVE-2025-48976), commons-beanutils
			     1.11.0 (CVE-2025-48734), handlebars 4.5.2 (CVE-2026-55760). -->
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.14.0</version>
			</dependency>
			<dependency>
				<groupId>commons-fileupload</groupId>
				<artifactId>commons-fileupload</artifactId>
				<version>1.6.0</version>
			</dependency>
			<dependency>
				<groupId>commons-beanutils</groupId>
				<artifactId>commons-beanutils</artifactId>
				<version>1.11.0</version>
			</dependency>
			<dependency>
				<groupId>com.github.jknack</groupId>
				<artifactId>handlebars</artifactId>
				<version>4.5.2</version>
			</dependency>
			<!-- Same rationale as above — fixed patch releases of lines Boot
			     3.5.16 already manages, pinned because its release predates the
			     security fixes: jackson 2.21.7 (core + databind + annotations),
			     netty 4.1.17 (via the netty.version property), Tomcat 10.1.61
			     (tomcat.version property), httpcore5 5.4.3, jetty http2 11.0.26,
			     PostgreSQL driver 42.7.14, lz4-java 1.11.4 (kafka-clients
			     transitive), bouncycastle 1.85. -->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>2.21.7</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>2.21.7</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<version>2.21</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5</artifactId>
				<version>5.4.3</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5-h2</artifactId>
				<version>5.4.3</version>
			</dependency>
			<!-- httpclient5 pinned as well: it is the artifact transitive graphs
			     pull in (elasticsearch's jetty transport / wiremock), and its own
			     dependency on httpcore5 would otherwise drag the CVE-flagged 5.0.x
			     line if any of those paths wins over the httpcore5 entry above. -->
			<dependency>
				<groupId>org.apache.httpcomponents.client5</groupId>
				<artifactId>httpclient5</artifactId>
				<version>5.5.2</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>http2-common</artifactId>
				<version>11.0.26</version>
			</dependency>
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>42.7.14</version>
			</dependency>
			<dependency>
				<groupId>at.yawk.lz4</groupId>
				<artifactId>lz4-java</artifactId>
				<version>1.11.4</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.85</version>
			</dependency>
			<!-- Shared platform library consumed by every service module. -->
 		<dependency>
 			<groupId>com.bhukkad</groupId>
 			<artifactId>platform-lib</artifactId>
 			<version>${project.version}</version>
 		</dependency>

			<dependency>
				<groupId>net.bytebuddy</groupId>
				<artifactId>byte-buddy</artifactId>
				<version>${byte-buddy.version}</version>
			</dependency>
			<dependency>
				<groupId>net.bytebuddy</groupId>
				<artifactId>byte-buddy-agent</artifactId>
				<version>${byte-buddy.version}</version>
			</dependency>
			<!-- Lettuce connection pooling. spring-boot-starter-data-redis marks
			     commons-pool2 optional, so with
			     spring.data.redis.lettuce.pool.enabled=true the pool was
			     silently never built and the configured budgets
			     (max-active / max-idle / max-wait) had no effect. Modules that
			     turn pooling on must declare it; admin needs it or the Redis
			     health contributor fails with
			     NoClassDefFoundError: GenericObjectPoolConfig. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-pool2</artifactId>
			</dependency>
			<!-- OpenTelemetry distributed tracing (H3). All services inherit
			     these via dependencyManagement; each service module declares
			     opentelemetry-spring-boot-starter in its own dependencies
			     section to enable tracing. -->
			<!-- OpenTelemetry BOM temporarily commented out
			     due to unavailable artifacts in local Maven repo (no network).
			     opentelemetry-api and related artifacts are not available locally. -->
			<!--
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-bom</artifactId>
				<version>1.39.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			-->
			<!-- OpenTelemetry instrumentation BOM temporarily commented out
			     due to unavailable artifact in local Maven repo (no network).
			     opentelemetry-bom:1.39.0 is imported above and covers core needs. -->
			<!--
			<dependency>
				<groupId>io.opentelemetry.instrumentation</groupId>
				<artifactId>opentelemetry-instrumentation-bom</artifactId>
				<version>1.39.0-alpha</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			-->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.85</version>
			</dependency>
			<!-- AWS SDK v2 BOM temporarily commented out due to unavailable
			     artifact in local Maven repo (no network). Individual AWS SDK
			     modules declare explicit versions below. -->
			<!--
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>aws-sdk-bom</artifactId>
				<version>2.31.5</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			-->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>s3</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>dynamodb</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>sqs</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>sns</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>secretsmanager</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>kms</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>cloudwatch</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>iam</artifactId>
				<version>2.31.5</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>apache-client</artifactId>
				<version>2.31.5</version>
			</dependency>
			<!-- Spring Cloud AWS starter for seamless Spring Boot integration
			     with AWS SDK v2. Provides @EnableAwsConfig, ResourceLoader,
			     and auto-configuration for S3, DynamoDB, SQS, SNS, etc. -->
			<dependency>
				<groupId>io.awspring.cloud</groupId>
				<artifactId>spring-cloud-aws-starter</artifactId>
				<version>3.2.3</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Shared TEST infrastructure. Testcontainers used to be declared at
	     COMPILE scope in platform-lib, which leaked testcontainers (and
	     docker-java's shaded httpclient5 5.0.2 / jetty 11) into every
	     service's production image — exactly the libraries the CI Trivy gate
	     flagged. Test scope is not transitive, so declaring the container
	     modules here gives every module's tests what they need while keeping
	     them out of BOOT-INF/lib. -->
	<dependencies>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>redpanda</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- JaCoCo coverage gate for every service module (approved plan
			     Phases 29–30: 100% target with meaningful tests; enforced
			     minimums aligned with the monolith's gate while services are
			     young). Thresholds are raised as coverage grows — never by
			     excluding business logic. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<!-- Data containers, generated code and bootstrap are
						     excluded; business logic stays in scope. -->
						<exclude>com/bhukkad/*/dto/**</exclude>
						<exclude>com/bhukkad/*/api/dto/**</exclude>
						<exclude>com/bhukkad/*/entity/**</exclude>
						<exclude>com/bhukkad/*/domain/entity/**</exclude>
						<exclude>com/bhukkad/*/*Application.class</exclude>
						<exclude>com/bhukkad/common/**/*Config.class</exclude>
					</excludes>
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
							<!-- Regression-protection floor for the young service
							     modules, aligned to the Part IV coverage ramp
							     (docs/TECHNICAL-AUDIT-FEATURE-ROADMAP.md): this is
							     the highest UNIFORM floor the reactor passes today
							     (per-module floors are not expressible in the
							     parent pom). Measured full-reactor run 2026-09-11
							     (./mvnw -f services/pom.xml test):
							       LINE   binding module survey    34.9% -> 0.34
							       BRANCH binding module restaurant 23.7% -> 0.23
							       METHOD binding module survey    36.1% -> 0.35
							     Ramp-step 2 target is >=45% overall (>=60% for
							     gateway/delivery/admin-analytics/identity). KNOWN
							     GAPS still below the ramp target (their test
							     backlog lives with the service-extraction
							     batches; do NOT pad with filler tests):
							       survey 34.9%, restaurant 43.2%, order 43.2%,
							       referral 47.0% (meets 45% only marginally).
							     Raise the floor as each module's measured
							     coverage grows — never by excluding business
							     logic. -->
							<limit>
								<counter>LINE</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.34</minimum>
							</limit>
							<limit>
								<counter>BRANCH</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.23</minimum>
							</limit>
							<limit>
								<counter>METHOD</counter>
								<value>COVEREDRATIO</value>
								<minimum>0.35</minimum>
							</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Inherited by every module: pre-load Byte Buddy as a -javaagent so
			     Mockito's inline mock-maker never performs dynamic self-attachment
			     (same rationale as the monolith pom: JDK 17 attach races poison the
			     surefire fork). Declared here (not pluginManagement) so the copy
			     execution actually runs in each module. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-byte-buddy-agent</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<artifactItems>
								<artifactItem>
									<groupId>net.bytebuddy</groupId>
									<artifactId>byte-buddy-agent</artifactId>
									<version>${byte-buddy.version}</version>
									<type>jar</type>
									<destFileName>byte-buddy-agent.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- JaCoCo coverage gate for every service module (approved plan
				     Phases 29–30: 100% target with meaningful tests; enforced
				     minimums aligned with the monolith's gate while services are
				     young). Thresholds are raised as coverage grows — never by
				     excluding business logic. -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>0.8.13</version>
					<configuration>
						<excludes>
							<!-- Data containers, generated code and bootstrap are
							     excluded; business logic stays in scope. -->
							<exclude>com/bhukkad/*/dto/**</exclude>
							<exclude>com/bhukkad/*/api/dto/**</exclude>
							<exclude>com/bhukkad/*/entity/**</exclude>
							<exclude>com/bhukkad/*/domain/entity/**</exclude>
							<exclude>com/bhukkad/*/*Application.class</exclude>
							<exclude>com/bhukkad/common/**/config/*Properties*</exclude>
							<exclude>com/bhukkad/common/**/*Config.class</exclude>
						</excludes>
						<rules>
							<rule>
								<element>BUNDLE</element>
								<limits>
									<!-- P2 repair: keep the managed block in lock-step
									     with the EFFECTIVE build/plugins rule above
									     (the previous 0.70/0.50/0.60 values here were
									     dead config that never applied — a module
									     plugin declaration with its own configuration
									     overrides pluginManagement). This block only
									     applies to modules that opt out of the parent
									     build section; do not diverge from the
									     effective values. -->
									<limit>
										<counter>LINE</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.34</minimum>
									</limit>
									<limit>
										<counter>BRANCH</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.23</minimum>
									</limit>
									<limit>
										<counter>METHOD</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.35</minimum>
									</limit>
								</limits>
							</rule>
						</rules>
					</configuration>
					<executions>
						<execution>
							<id>jacoco-prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>test</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Djdk.attach.allowAttachSelf=false</argLine>
						<forkCount>1</forkCount>
						<reuseForks>true</reuseForks>
						<runOrder>alphabetical</runOrder>
						<systemPropertyVariables>
							<api.version>1.44</api.version>
						</systemPropertyVariables>
					</configuration>
				</plugin>
<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>
					<useIncrementalCompilation>false</useIncrementalCompilation>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
