# Simple Dockerfile for admin service - copies pre-built jar
FROM eclipse-temurin:21-jre-jammy

ENV TZ=Asia/Kolkata \
    LANG=C.UTF-8 \
    SPRING_PROFILES_ACTIVE=local \
    SERVER_PORT=8080 \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError -XX:+UseStringDeduplication -Xlog:gc*:file=/tmp/logs/bhukkad/gc.log:time,uptime:filecount=5,filesize=20M -Djava.security.egd=file:/dev/./urandom"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo "$TZ" > /etc/timezone \
    && groupadd -r -g 1001 bhukkad \
    && useradd -r -u 1001 -g bhukkad -d /app -s /usr/sbin/nologin bhukkad \
    && mkdir -p /tmp/logs/bhukkad /app \
    && chown -R bhukkad:bhukkad /tmp/logs/bhukkad /app

WORKDIR /app
COPY --chown=bhukkad:bhukkad admin-1.0.0.jar /app/app.jar
USER bhukkad
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=10 \
  CMD curl -fsS "http://localhost:${SERVER_PORT}/actuator/health/readiness" >/dev/null || exit 1
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]