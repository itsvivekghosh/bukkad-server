<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.bhukkad</groupId>
		<artifactId>bhukkad-microservices</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>gateway</artifactId>
	<name>Bhukkad API Gateway</name>
	<description>Edge gateway (P0). A single reactive Spring Cloud Gateway that
		fronts the monolith and newly-cut services. Traffic is split by path so
		strangler flips are route-only edits; auth is passthrough (each service
		validates its own JWT via platform-lib's PlatformJwtValidator).</description>

	<dependencies>
		<!-- Shared platform infra: actuator health/metrics wiring, tracing,
		     error model. No web/datasource; web-starter is optional in
		     platform-lib so this module stays purely reactive (WebFlux). -->
		<dependency>
			<groupId>com.bhukkad</groupId>
			<artifactId>platform-lib</artifactId>
		</dependency>

		<!-- Spring Cloud Gateway (WebFlux + Netty). Deliberately NOT
		     spring-boot-starter-web (Servlet) — the gateway is a reactive edge. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway</artifactId>
		</dependency>

		<!-- Health/liveness/readiness + metrics for probes + Prometheus scrape. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Reactive Redis: edge kill switch reads the shared feature-flag
		     override hash (see EdgeFeatureFlags). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>

		<!-- SpringDoc OpenAPI (reactive). -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
			<version>2.2.0</version>
		</dependency>

		<!-- Test deps inherited via spring-boot-starter-test (JUnit 5, WebTestClient, AssertJ). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- StepVerifier for reactive filter tests (V-13 kill-switch offload). -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- BlockHound (P1): proves the kill switch never runs the (blocking)
		     JWT subject lookup on a non-blocking thread. Test scope only;
		     1.0.8.RELEASE is the JDK 17-compatible line (not managed by the
		     Boot/Reactor BOM). -->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<version>1.0.8.RELEASE</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- This module has no Lombok/MapStruct usage; annotation
					     processing is disabled so the parent's Lombok processor
					     (incompatible with the build JDK) never loads. -->
					<proc>none</proc>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Pre-load BlockHound as a -javaagent: dynamic self-attach is
			     disabled by the parent surefire argLine, and an agent-loaded
			     BlockHound is the CI-stable integration path. The tests
			     activate it with BlockHound.install(). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-blockhound-agent</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<artifactItems>
								<artifactItem>
									<groupId>io.projectreactor.tools</groupId>
									<artifactId>blockhound</artifactId>
									<version>1.0.8.RELEASE</version>
									<type>jar</type>
									<destFileName>blockhound.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Parent argLine (jacoco @{argLine} + byte-buddy agent)
					     plus the preloaded BlockHound agent. -->
					<argLine>@{argLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Djdk.attach.allowAttachSelf=false -XX:+AllowRedefinitionToAddDeleteMethods -javaagent:${project.build.directory}/blockhound.jar</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
