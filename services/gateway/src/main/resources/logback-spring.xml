<?xml version="1.0" encoding="UTF-8"?>
<!--
  This service logs exclusively through the shared platform configuration in
  platform-lib's classpath resource logback-bhukkad.xml. The shared CONSOLE_JSON
  appender is defined there so traceId/spanId and trace_id/span_id stay
  consistent across the fleet; this file only activates it for prod.
-->
<configuration>
    <include resource="logback-bhukkad.xml"/>
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
</configuration>
