<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.bhukkad</groupId>
		<artifactId>bhukkad-microservices</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>platform-lib</artifactId>
	<name>Bhukkad Common Platform Library</name>
	<description>Platform infrastructure shared by every microservice: outbox
		client, saga coordinator, idempotency primitives, event envelope,
		tracing and error model (architecture-microservices-postgresql.md §4).
		No web layer, no datasource configuration, no business logic — business
		code is never shared across services (contract/event boundaries).</description>

	<!-- 1.18.38 fixes the javac TypeTag crash on JDK 21+ (parent still pins
	     1.18.36 for the monolith). -->
	<properties>
		<lombok.version>1.18.38</lombok.version>
	</properties>

	<dependencies>
		<!-- JPA entities + repositories for the per-service platform tables. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- AWS S3 for shared image/blob storage (menu presigned URLs). -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.25.27</version>
		</dependency>

		<!-- JSON (de)serialization of event payloads and envelopes. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- Web-coupled platform infrastructure (GlobalExceptionHandler, request
		     tracing filter, JWT verifier). Optional so the library stays lean:
		     services that expose REST already bring spring-boot-starter-web. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- WebFlux for service-to-service communication (WebClient). Optional:
		     services that call other services bring this in. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Spring Cloud LoadBalancer for service-to-service calls (no Eureka needed). -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- AOP for the platform aspects (RateLimitAspect, MetricsAspect, cache
		     invalidation). Optional; services opt in with starter-aop. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Security infrastructure shared by every service that opts in:
		     PlatformJwtValidator (HS256/JWKS) and PlatformJwtAuthFilter.
		     Optional so non-web services stay lean; services that expose REST
		     add spring-boot-starter-security explicitly. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Nimbus JOSE + JWT for signature verification (MACVerifier/HS256,
		     RSASSAVerifier/RS256 + JWKS). Declared via spring-security-oauth2-jose
		     so nimbus-jose-jwt resolves with a Spring-managed version (same
		     convention as the identity service; no pinning). Non-optional:
		     PlatformJwtValidator/PlatformJwtAuthFilter are @Component-scanned
		     into every service, so every consumer needs nimbus on the
		     classpath to load them. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!-- JJWT for service-to-service JWT tokens. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Caffeine L1 cache for the two-tier platform cache. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Micrometer API for platform metrics (binding chosen by the service). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>

		<!-- Distributed tracing (OpenTelemetry bridge to Zipkin/Jaeger). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>

		<!-- Resilience4j for circuit breaker and retry in service-to-service calls. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-micrometer</artifactId>
		</dependency>
		<!-- Reactor adapter for the WebClient CircuitBreakerOperator (PERF-1/V-16:
		     the breaker must DECORATE the exchange with transformDeferred).
		     Version from the resilience4j-bom imported via the Spring Cloud BOM. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-reactor</artifactId>
		</dependency>

		<!-- Kafka publisher/consumer support. Optional: only services that own a
		     Kafka producer/consumer group declare spring-kafka. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ShedLock annotations for platform schedulers (V-19 idempotency cleanup).
		     Optional (same pattern as spring-kafka): services that already declare
		     shedlock-spring (order, admin-analytics) get the lock honoured; the
		     annotation is silently absent elsewhere and the sweep stays idempotent. -->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>5.16.0</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>5.16.0</version>
		</dependency>

		<!-- SLF4J API only — binding is chosen by the consuming service. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<!-- Redis for distributed rate limiting, caching, and pub/sub. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- WebSocket support for real-time features (order tracking, live updates).
		     Optional: only services that own WebSocket endpoints declare this. Keeping
		     it optional prevents spring-webmvc (transitive of WebSocket) from leaking
		     into reactive consumers (the gateway), where it would trigger
		     GatewayClassPathWarningAutoConfiguration$SpringMvcFoundOnClasspathException. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- OpenAPI / Swagger UI for service API docs. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.2.0</version>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Testing: PG Testcontainers + Flyway validate the platform baseline and
		     repository queries against a real PostgreSQL; ArchUnit guards the
		     no-web/no-monolith boundary. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- StepVerifier for the reactive WebClient filters (PERF-1/V-16). -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- BlockHound (P1): proves the JWT warm path and reactive filters never
		     perform blocking calls on non-blocking threads. Test scope only.
		     1.0.8.RELEASE is the JDK 17-compatible line (not managed by the
		     Boot/Reactor BOM). -->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<version>1.0.8.RELEASE</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Redpanda (Kafka-compatible) for the Kafka publisher integration test. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>redpanda</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- JDBC driver for the PG Testcontainers integration tests. Services add
		     their own runtime driver; the library itself must not force one. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Pre-load BlockHound as a -javaagent: dynamic self-attach is
			     disabled by the parent surefire argLine, and an agent-loaded
			     BlockHound is the CI-stable integration path. The tests
			     activate it with BlockHound.install(). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-blockhound-agent</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<artifactItems>
								<artifactItem>
									<groupId>io.projectreactor.tools</groupId>
									<artifactId>blockhound</artifactId>
									<version>1.0.8.RELEASE</version>
									<type>jar</type>
									<destFileName>blockhound.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Parent argLine (jacoco @{argLine} + byte-buddy agent)
					     plus the preloaded BlockHound agent. -->
					<argLine>@{argLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Djdk.attach.allowAttachSelf=false -XX:+AllowRedefinitionToAddDeleteMethods -javaagent:${project.build.directory}/blockhound.jar</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
