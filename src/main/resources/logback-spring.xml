<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="bhukkad-server"/>

    <!-- All server logs live under /tmp/logs/bhukkad/<service>/ (never inside the
         repository). A single SiftingAppender template is parameterized by the
         logger-name discriminator (ServiceLogDiscriminator), so each service
         (order, payment, user, notification, core) gets its own directory without
         duplicating the rolling-file configuration.

         Structure (no nested appenders — required by Logback ≥ 1.3):
           ROOT → ASYNC_SIFT (single async queue)
                    → SIFT (routes by event logger name)
                         → FILE_${service} (synchronous RollingFileAppender)

         Because the discriminator derives the service from the event's logger
         name (not thread-local MDC), routing stays correct across the async
         queue and on scheduler/background threads.

         The <file> element is intentionally OMITTED so the RollingFileAppender
         derives the active file name from fileNamePattern — i.e. the active file
         IS the current hour's named file: server_DD-MM-YYYY-HH.log. This yields,
         natively:
           • hourly rotation driven by each log entry's timestamp (TimeBasedRollingPolicy)
           • correct file name at all times, even before the first rollover
           • restart within the same hour → same file → append (no duplicate)
           • restart at a new hour → that hour's file
           • midnight transition → immediately the new date's server_DD-MM-YYYY-00.log
         Both LOG_PATTERN and fileNamePattern derive their timezone from the JVM
         default (the server timezone), so entry timestamps and filenames never mix
         timezones. Directories are created automatically by Logback on appender
         start.                                                                    -->
    <property name="LOG_PATH" value="/tmp/logs/bhukkad"/>
    <property name="MAX_HISTORY" value="168"/> <!-- hourly files → 7 days -->

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%thread] [trace:%X{traceId:--}] [req:%X{requestId:--}] [user:%X{userId:--}] [%logger{36}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%yellow(%X{traceId:--})] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Per-service file appender: one template, parameterized by ${service}. -->
    <appender name="SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="com.bhukkad.logging.ServiceLogDiscriminator"/>
        <sift>
            <appender name="FILE_${service}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_PATH}/${service}/server_%d{dd-MM-yyyy-HH}.log</fileNamePattern>
                    <maxHistory>${MAX_HISTORY}</maxHistory>
                </rollingPolicy>
                <encoder>
                    <pattern>${LOG_PATTERN}</pattern>
                    <charset>UTF-8</charset>
                </encoder>
            </appender>
        </sift>
    </appender>

    <appender name="ASYNC_SIFT" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="SIFT"/>
    </appender>

    <!-- Domain loggers route to their service directory via the discriminator -->
    <logger name="ORDER" level="INFO"/>
    <logger name="PAYMENT" level="INFO"/>
    <logger name="SECURITY" level="INFO"/>
    <logger name="PERFORMANCE" level="INFO"/>
    <logger name="ALERT" level="INFO"/>

    <logger name="com.bhukkad" level="DEBUG"/>
    <logger name="com.bhukkad.logging" level="DEBUG"/>
    <logger name="com.bhukkad.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_SIFT"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_SIFT"/>
        </root>
    </springProfile>

    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_SIFT"/>
        </root>
    </springProfile>

</configuration>
